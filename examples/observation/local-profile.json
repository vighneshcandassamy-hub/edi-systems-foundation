{
  "schema_version": "1.0",
  "database": ".local/edi.sqlite3",
  "workspace_id": "forest-demo",
  "max_chunk_bytes": 1048576,
  "max_record_bytes": 67108864,
  "max_chunks_per_record": 4096,
  "max_metadata_bytes": 65536,
  "max_records": 1000000,
  "max_origins": 10000,
  "max_consumers": 1000,
  "max_payload_bytes": 4294967296,
  "min_free_disk_bytes": 268435456,
  "max_concurrent_operations": 4,
  "max_page_records": 100,
  "max_read_bytes": 4194304,
  "writer_timeout_seconds": 5.0,
  "max_ingest_seconds": 30.0,
  "max_backup_seconds": 300.0
}
