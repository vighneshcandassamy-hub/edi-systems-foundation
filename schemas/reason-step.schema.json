{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "inquiry_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Inquiry Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "action": {
      "enum": [
        "student",
        "teacher",
        "yield",
        "cancel-pending"
      ],
      "title": "Action",
      "type": "string"
    },
    "reason": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "teacher_trigger": {
      "anyOf": [
        {
          "enum": [
            "novel",
            "unresolved",
            "consequential",
            "student-escalation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Teacher Trigger"
    }
  },
  "required": [
    "workspace_id",
    "inquiry_id",
    "request_id",
    "action",
    "reason"
  ],
  "title": "StepRequest",
  "type": "object"
}
