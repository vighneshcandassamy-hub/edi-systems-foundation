        "deliverer": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Deliverer",
          "type": "string"
        },
        "channel": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Channel",
          "type": "string"
        },
        "adapter": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Adapter",
          "type": "string"
        },
        "producer": {
          "anyOf": [
