{
  "$defs": {
    "Correspondence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stock_symbol": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Stock Symbol",
          "type": "string"
        },
        "observation_channel": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Observation Channel",
          "type": "string"
        },
        "aggregation": {
          "const": "instantaneous-state",
          "default": "instantaneous-state",
          "title": "Aggregation",
          "type": "string"
        },
        "limitation": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Limitation",
          "type": "string"
        }
      },
      "required": [
        "stock_symbol",
        "observation_channel",
        "limitation"
      ],
      "title": "Correspondence",
      "type": "object"
    },
    "Driver": {
      "additionalProperties": false,
      "description": "External piecewise-constant boundary input, not an inferred causal driver.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "symbol",
        "value",
        "unit",
        "lower",
        "upper"
      ],
      "title": "Driver",
      "type": "object"
    },
    "DriverSchedule": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "points": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "symbol",
        "points"
      ],
      "title": "DriverSchedule",
      "type": "object"
    },
    "EvaluationRule": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_policy": {
          "const": "first-matching-measurement-by-commit",
          "default": "first-matching-measurement-by-commit",
          "title": "Selection Policy",
          "type": "string"
        },
        "aggregation": {
          "const": "instantaneous-state",
          "default": "instantaneous-state",
          "title": "Aggregation",
          "type": "string"
        },
        "require_disjoint_sources": {
          "default": true,
          "title": "Require Disjoint Sources",
          "type": "boolean"
        },
        "source_independence_assumption": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Source Independence Assumption",
          "type": "string"
        },
        "calibration_edges": {
          "default": [
            0.0,
            0.25,
            0.5,
            0.75,
            1.0
          ],
          "items": {
            "type": "number"
          },
          "title": "Calibration Edges",
          "type": "array"
        },
        "missing_policy": {
          "const": "retain-denominator; no-imputation",
          "default": "retain-denominator; no-imputation",
          "title": "Missing Policy",
          "type": "string"
        },
        "censored_policy": {
          "const": "report-unscored",
          "default": "report-unscored",
          "title": "Censored Policy",
          "type": "string"
        }
      },
      "required": [
        "source_independence_assumption"
      ],
      "title": "EvaluationRule",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "selector": {
          "default": "whole-object",
          "title": "Selector",
          "type": "string"
        },
        "origin_class": {
          "default": "unknown",
          "enum": [
            "external",
            "generated",
            "simulation",
            "unknown"
          ],
          "title": "Origin Class",
          "type": "string"
        },
        "lineage": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Lineage",
          "type": "array"
        }
      },
      "required": [
        "workspace_id",
        "record_id",
        "sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FlowSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "world_ref": {
          "$ref": "#/$defs/Ref"
        },
        "rate_node": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Rate Node",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "sink": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sink"
        }
      },
      "required": [
        "symbol",
        "world_ref",
        "rate_node"
      ],
      "title": "FlowSpec",
      "type": "object"
    },
    "ForecastCase": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "case_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "stock_symbol": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Stock Symbol",
          "type": "string"
        },
        "relative_time": {
          "title": "Relative Time",
          "type": "number"
        },
        "origin_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Origin Ref",
          "type": "string"
        },
        "variable": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Variable",
          "type": "string"
        },
        "declared_dependence_group": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Declared Dependence Group",
          "type": "string"
        },
        "interpretation": {
          "enum": [
            "point",
            "bernoulli-probability"
          ],
          "title": "Interpretation",
          "type": "string"
        },
        "score_limit": {
          "minimum": 0,
          "title": "Score Limit",
          "type": "number"
        },
        "interpretation_basis": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Interpretation Basis",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "stock_symbol",
        "relative_time",
        "origin_ref",
        "variable",
        "declared_dependence_group",
        "interpretation",
        "score_limit",
        "interpretation_basis"
      ],
      "title": "ForecastCase",
      "type": "object"
    },
    "ForecastSeal": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "request": {
          "$ref": "#/$defs/SealRequest"
        },
        "prepared_at": {
          "format": "date-time",
          "title": "Prepared At",
          "type": "string"
        },
        "c1_watermark": {
          "minimum": 0,
          "title": "C1 Watermark",
          "type": "integer"
        },
        "run_sha256": {
          "title": "Run Sha256",
          "type": "string"
        },
        "compiled_sha256": {
          "title": "Compiled Sha256",
          "type": "string"
        },
        "model_revision": {
          "title": "Model Revision",
          "type": "integer"
        },
        "run_request": {
          "$ref": "#/$defs/RunRequest"
        },
        "program_snapshot": {
          "$ref": "#/$defs/Program"
        },
        "active_parameters": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Active Parameters",
          "type": "object"
        },
        "model_refs": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Model Refs",
          "type": "array"
        },
        "model_assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Model Assumptions",
          "type": "array"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "input_source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Input Source Ids",
          "type": "array"
        },
        "outcome_origins": {
          "items": {
            "$ref": "#/$defs/Origin"
          },
          "title": "Outcome Origins",
          "type": "array"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/SealedPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "artifact_sha256": {
          "title": "Artifact Sha256",
          "type": "string"
        },
        "profile_snapshot": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Profile Snapshot",
          "type": "object"
        },
        "status": {
          "const": "payload-durable; confirmation-required",
          "default": "payload-durable; confirmation-required",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "request",
        "prepared_at",
        "c1_watermark",
        "run_sha256",
        "compiled_sha256",
        "model_revision",
        "run_request",
        "program_snapshot",
        "active_parameters",
        "model_refs",
        "model_assumptions",
        "inputs",
        "input_source_ids",
        "outcome_origins",
        "points",
        "artifact_sha256",
        "profile_snapshot"
      ],
      "title": "ForecastSeal",
      "type": "object"
    },
    "JsonValue": {},
    "Node": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "node_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "operator": {
          "enum": [
            "constant",
            "read",
            "add",
            "subtract",
            "multiply",
            "divide",
            "negate",
            "min",
            "max",
            "lookup"
          ],
          "title": "Operator",
          "type": "string"
        },
        "inputs": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 2,
          "title": "Inputs",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "symbol": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "y_unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/Unit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "points": {
          "default": [],
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "maxItems": 128,
          "title": "Points",
          "type": "array"
        },
        "extrapolation": {
          "default": "error",
          "enum": [
            "error",
            "clamp"
          ],
          "title": "Extrapolation",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "operator"
      ],
      "title": "Node",
      "type": "object"
    },
    "Origin": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "origin_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Origin Ref",
          "type": "string"
        },
        "registered_at": {
          "format": "date-time",
          "title": "Registered At",
          "type": "string"
