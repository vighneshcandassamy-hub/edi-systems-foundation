          "title": "Drivers",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/Node"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Nodes",
          "type": "array"
        },
        "flows": {
          "items": {
            "$ref": "#/$defs/FlowSpec"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Flows",
          "type": "array"
        },
        "required_capabilities": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
