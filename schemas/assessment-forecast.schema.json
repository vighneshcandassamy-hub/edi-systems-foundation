      "required": [
        "namespace",
        "native_source_id",
        "epoch",
        "deliverer",
        "channel",
        "adapter"
      ],
      "title": "OriginSpec",
      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "symbol": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Symbol",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "symbol",
        "value",
        "unit",
        "lower",
        "upper"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "Program": {
      "additionalProperties": false,
