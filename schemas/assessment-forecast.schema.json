            "reported",
            "configured",
            "authenticated"
          ],
          "title": "Binding Basis",
          "type": "string"
        },
        "binding_evidence_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Evidence Ref"
        },
        "descriptor": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Descriptor",
          "type": "object"
