{
  "$defs": {
    "Admission": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "decision": {
          "default": "candidate",
          "enum": [
            "candidate",
            "accepted_for_use",
            "rejected",
            "withdrawn"
          ],
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "use_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Use Scope"
        },
        "verification_obligation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Obligation"
        },
        "policy_id": {
          "const": "local-modeling-use/1.0",
          "default": "local-modeling-use/1.0",
          "title": "Policy Id",
          "type": "string"
        }
      },
      "required": [
        "rationale"
      ],
      "title": "Admission",
      "type": "object"
    },
    "CandidateChange": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "hypothesis_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "put": {
          "$ref": "#/$defs/Put"
        }
      },
      "required": [
        "hypothesis_id",
        "put"
      ],
      "title": "CandidateChange",
      "type": "object"
    },
    "Constituent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "const": "constituent",
          "default": "constituent",
          "title": "Family",
          "type": "string"
        },
        "parts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Parts",
          "type": "array"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "condition": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Condition",
          "type": "object"
        },
        "lifecycle": {
          "default": "unknown",
          "title": "Lifecycle",
          "type": "string"
        }
      },
      "title": "Constituent",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "selector": {
          "default": "whole-object",
          "title": "Selector",
          "type": "string"
        },
        "origin_class": {
          "default": "unknown",
          "enum": [
            "external",
            "generated",
            "simulation",
            "unknown"
          ],
          "title": "Origin Class",
          "type": "string"
        },
        "lineage": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Lineage",
          "type": "array"
        }
      },
      "required": [
        "workspace_id",
        "record_id",
        "sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FeedbackPath": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "const": "feedback-path",
          "default": "feedback-path",
          "title": "Family",
          "type": "string"
        },
        "mechanisms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Mechanisms",
          "type": "array"
        },
        "closure": {
          "default": "unknown",
          "enum": [
            "unknown",
            "hypothesized",
            "reported"
          ],
          "title": "Closure",
          "type": "string"
        },
        "polarity": {
          "default": "unknown",
          "enum": [
            "unknown",
            "balancing",
            "reinforcing",
            "context-dependent"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "delays": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Delays",
          "type": "object"
        },
        "applicability": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Applicability",
          "type": "object"
        }
      },
      "title": "FeedbackPath",
      "type": "object"
    },
    "FlowProcess": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "const": "flow-process",
          "default": "flow-process",
          "title": "Family",
          "type": "string"
        },
        "participants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Participant"
          },
          "title": "Participants",
          "type": "array"
        },
        "rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prerequisites": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "pending_commitments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Pending Commitments",
          "type": "array"
        },
        "transformation": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Transformation",
          "type": "object"
        },
        "time_basis": {
          "default": "unknown",
          "title": "Time Basis",
          "type": "string"
        },
        "resource_use": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Resource Use",
          "type": "object"
        }
      },
      "title": "FlowProcess",
      "type": "object"
    },
    "FrontierItem": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "frontier_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Frontier Id",
          "type": "string"
        },
        "direction": {
          "enum": [
            "expand_adjacent",
            "refine_internal",
            "resolve_identity",
            "refresh_temporal",
            "test_mechanism",
            "check_boundary",
            "review_abstraction"
          ],
          "title": "Direction",
          "type": "string"
        },
        "trigger": {
          "enum": [
            "unexplained_prediction_error",
            "contradictory_source",
            "uncertain_high_impact_interface",
            "near_threshold",
            "aging_assumption",
            "insufficient_resolution",
            "decision_sensitive_unknown",
            "bounded_periodic_review"
          ],
          "title": "Trigger",
          "type": "string"
        },
        "target": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "unknown": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Unknown",
          "type": "string"
        },
        "hypothesis_family": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Hypothesis Family",
          "type": "string"
        },
        "capability_scope": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Capability Scope",
          "type": "array"
        },
        "relevance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Relevance",
          "type": "number"
        },
        "discrimination": {
          "maximum": 1,
          "minimum": 0,
          "title": "Discrimination",
          "type": "number"
        },
        "impact": {
          "maximum": 1,
          "minimum": 0,
          "title": "Impact",
          "type": "number"
        },
        "feasibility": {
          "maximum": 1,
          "minimum": 0,
          "title": "Feasibility",
          "type": "number"
        },
        "relative_cost": {
          "maximum": 1,
          "minimum": 0,
          "title": "Relative Cost",
          "type": "number"
        },
        "rationale": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "state": {
          "default": "open",
          "enum": [
            "open",
            "deferred",
            "denied",
            "resolved"
          ],
          "title": "State",
          "type": "string"
        },
        "disposition_reason": {
          "default": "awaiting C0 scheduling/access review",
          "maxLength": 8192,
          "minLength": 1,
          "title": "Disposition Reason",
          "type": "string"
        },
        "material_change": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Material Change"
        }
      },
      "required": [
        "frontier_id",
        "direction",
        "trigger",
        "target",
        "unknown",
        "hypothesis_family",
        "relevance",
        "discrimination",
        "impact",
        "feasibility",
        "relative_cost",
        "rationale"
      ],
      "title": "FrontierItem",
      "type": "object"
    },
    "HistoryTrajectory": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "const": "history-conditional-trajectory",
          "default": "history-conditional-trajectory",
          "title": "Family",
          "type": "string"
        },
        "referents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Referents",
          "type": "array"
        },
        "origin": {
          "default": "unknown",
          "enum": [
            "observation",
            "source-report",
            "forecast",
            "simulation",
            "unknown"
          ],
          "title": "Origin",
          "type": "string"
        },
        "initial_history": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Initial History",
          "type": "array"
        },
        "points": {
          "default": [],
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Points",
          "type": "array"
        },
        "time_units_aggregation": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Time Units Aggregation",
          "type": "object"
        },
        "driver_assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Driver Assumptions",
          "type": "array"
        },
        "model_policy_versions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Model Policy Versions",
          "type": "object"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "horizon": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Horizon",
          "type": "object"
        }
      },
      "title": "HistoryTrajectory",
      "type": "object"
    },
    "Hypothesis": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "hypothesis_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "claim": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Claim",
          "type": "string"
        },
        "mechanism": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Mechanism",
          "type": "string"
        },
        "scope": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "support": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 32,
          "title": "Support",
          "type": "array"
        },
        "counterevidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "maxItems": 32,
          "title": "Counterevidence",
          "type": "array"
        },
        "dependence_groups": {
          "default": [],
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Dependence Groups",
          "type": "array"
        },
        "assumptions": {
          "default": [],
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Assumptions",
          "type": "array"
        },
        "confounders": {
          "default": [],
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Confounders",
          "type": "array"
        },
        "applicability": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Applicability",
          "type": "string"
        },
        "unknowns": {
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Unknowns",
          "type": "array"
        },
        "predictions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Prediction"
          },
          "maxItems": 8,
          "title": "Predictions",
          "type": "array"
        },
        "rivals": {
          "default": [],
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "title": "Rivals",
          "type": "array"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "claim",
        "mechanism",
        "scope",
        "applicability",
        "unknowns"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "InformationLink": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "const": "information-influence-link",
          "default": "information-influence-link",
          "title": "Family",
          "type": "string"
        },
        "participants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Participant"
          },
          "title": "Participants",
          "type": "array"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "meaning": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Meaning",
          "type": "object"
        },
        "availability_receipt_attention": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Availability Receipt Attention",
          "type": "object"
        },
        "distortion": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Distortion",
          "type": "object"
        },
        "causal_status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "hypothesized",
            "reported"
          ],
          "title": "Causal Status",
          "type": "string"
        }
      },
      "title": "InformationLink",
      "type": "object"
    },
    "InquiryTest": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "test_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Test Id",
          "type": "string"
        },
        "discriminates": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Discriminates",
          "type": "array"
        },
        "intervention_or_observation": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Intervention Or Observation",
          "type": "string"
        },
        "expected_differences": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Expected Differences",
          "type": "string"
        },
        "channels": {
          "items": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Channels",
          "type": "array"
        },
        "feasibility": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Feasibility",
          "type": "string"
        },
        "confounding_controls": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Confounding Controls",
          "type": "string"
        },
        "cost_and_risk": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Cost And Risk",
          "type": "string"
        },
        "identifiability_limit": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Identifiability Limit",
          "type": "string"
        },
        "kind": {
          "enum": [
            "observation",
            "qualitative-analysis",
            "numerical-analysis"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "const": "proposed-unrun",
          "default": "proposed-unrun",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "discriminates",
        "intervention_or_observation",
        "expected_differences",
        "channels",
        "feasibility",
        "confounding_controls",
        "cost_and_risk",
        "identifiability_limit",
        "kind"
      ],
      "title": "InquiryTest",
      "type": "object"
    },
    "JsonValue": {},
    "ModelBinding": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "model_id": {
          "default": "unbound",
          "maxLength": 256,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "revision": {
          "default": "unbound",
          "maxLength": 256,
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "provider": {
          "default": "unbound",
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "engine": {
          "default": "unbound",
          "maxLength": 256,
          "minLength": 1,
          "title": "Engine",
          "type": "string"
        },
        "tokenizer_revision": {
          "default": "unknown",
          "maxLength": 256,
          "minLength": 1,
          "title": "Tokenizer Revision",
          "type": "string"
        },
        "weights": {
          "const": "fixed",
          "default": "fixed",
          "title": "Weights",
          "type": "string"
        }
      },
      "title": "ModelBinding",
      "type": "object"
    },
    "OperationProposal": {
      "additionalProperties": false,
      "description": "Data-only request to C0; never a grant, operator input or execution receipt.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "operation": {
          "enum": [
            "world-call",
            "acquire-asset",
            "select-context",
            "analysis-compile",
            "analysis-run",
            "teacher-review",
            "component-call",
            "yield"
          ],
          "title": "Operation",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "operation",
        "arguments"
      ],
      "title": "OperationProposal",
      "type": "object"
    },
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
