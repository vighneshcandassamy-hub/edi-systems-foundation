{
  "$defs": {
    "Admission": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "decision": {
          "default": "candidate",
          "enum": [
            "candidate",
            "accepted_for_use",
            "rejected",
            "withdrawn"
          ],
          "title": "Decision",
          "type": "string"
        },
        "rationale": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "use_scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Use Scope"
        },
        "verification_obligation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Obligation"
        },
        "policy_id": {
          "const": "local-modeling-use/1.0",
          "default": "local-modeling-use/1.0",
          "title": "Policy Id",
          "type": "string"
        }
      },
      "required": [
        "rationale"
      ],
      "title": "Admission",
      "type": "object"
    },
    "Constituent": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "const": "constituent",
          "default": "constituent",
          "title": "Family",
          "type": "string"
        },
        "parts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Parts",
          "type": "array"
        },
        "roles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "condition": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Condition",
          "type": "object"
        },
        "lifecycle": {
          "default": "unknown",
          "title": "Lifecycle",
          "type": "string"
        }
      },
      "title": "Constituent",
      "type": "object"
    },
    "ConsumedEvidence": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "consumer_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Consumer Id",
          "type": "string"
        },
        "expected_position": {
          "minimum": 0,
          "title": "Expected Position",
          "type": "integer"
        },
        "position": {
          "minimum": 0,
          "title": "Position",
          "type": "integer"
        },
        "record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        }
      },
      "required": [
        "consumer_id",
        "expected_position",
        "position",
        "record_ids"
      ],
      "title": "ConsumedEvidence",
      "type": "object"
    },
    "Decide": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "operation": {
          "const": "decide",
          "default": "decide",
          "title": "Operation",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "expected_version": {
          "minimum": 1,
          "title": "Expected Version",
          "type": "integer"
        },
        "admission": {
          "$ref": "#/$defs/Admission"
        }
      },
      "required": [
        "record_id",
        "expected_version",
        "admission"
      ],
      "title": "Decide",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "selector": {
          "default": "whole-object",
          "title": "Selector",
          "type": "string"
        },
        "origin_class": {
          "default": "unknown",
          "enum": [
            "external",
            "generated",
            "simulation",
            "unknown"
          ],
          "title": "Origin Class",
          "type": "string"
        },
        "lineage": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Lineage",
          "type": "array"
        }
      },
      "required": [
        "workspace_id",
        "record_id",
        "sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "FeedbackPath": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "const": "feedback-path",
          "default": "feedback-path",
          "title": "Family",
          "type": "string"
        },
        "mechanisms": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Mechanisms",
          "type": "array"
        },
        "closure": {
          "default": "unknown",
          "enum": [
            "unknown",
            "hypothesized",
            "reported"
          ],
          "title": "Closure",
          "type": "string"
        },
        "polarity": {
          "default": "unknown",
          "enum": [
            "unknown",
            "balancing",
            "reinforcing",
            "context-dependent"
          ],
          "title": "Polarity",
          "type": "string"
        },
        "delays": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Delays",
          "type": "object"
        },
        "applicability": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Applicability",
          "type": "object"
        }
      },
      "title": "FeedbackPath",
      "type": "object"
    },
    "FlowProcess": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "const": "flow-process",
          "default": "flow-process",
          "title": "Family",
          "type": "string"
        },
        "participants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Participant"
          },
          "title": "Participants",
          "type": "array"
        },
        "rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prerequisites": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Prerequisites",
          "type": "array"
        },
        "pending_commitments": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Pending Commitments",
          "type": "array"
        },
        "transformation": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Transformation",
          "type": "object"
        },
        "time_basis": {
          "default": "unknown",
          "title": "Time Basis",
          "type": "string"
        },
        "resource_use": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Resource Use",
          "type": "object"
        }
      },
      "title": "FlowProcess",
      "type": "object"
    },
    "HistoryTrajectory": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "const": "history-conditional-trajectory",
          "default": "history-conditional-trajectory",
          "title": "Family",
          "type": "string"
        },
        "referents": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Referents",
          "type": "array"
        },
        "origin": {
          "default": "unknown",
          "enum": [
            "observation",
            "source-report",
            "forecast",
            "simulation",
            "unknown"
          ],
          "title": "Origin",
          "type": "string"
        },
        "initial_history": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Initial History",
          "type": "array"
        },
        "points": {
          "default": [],
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Points",
          "type": "array"
        },
        "time_units_aggregation": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Time Units Aggregation",
          "type": "object"
        },
        "driver_assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Driver Assumptions",
          "type": "array"
        },
        "model_policy_versions": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Model Policy Versions",
          "type": "object"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "horizon": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Horizon",
          "type": "object"
        }
      },
      "title": "HistoryTrajectory",
      "type": "object"
    },
    "InformationLink": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "const": "information-influence-link",
          "default": "information-influence-link",
          "title": "Family",
          "type": "string"
        },
        "participants": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Participant"
          },
          "title": "Participants",
          "type": "array"
        },
        "channel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Channel"
        },
        "meaning": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Meaning",
          "type": "object"
        },
        "availability_receipt_attention": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Availability Receipt Attention",
          "type": "object"
        },
        "distortion": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Distortion",
          "type": "object"
        },
        "causal_status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "hypothesized",
            "reported"
          ],
          "title": "Causal Status",
          "type": "string"
        }
      },
      "title": "InformationLink",
      "type": "object"
    },
    "JsonValue": {},
    "Participant": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/Ref"
        },
        "role": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "direction": {
          "default": "unknown",
          "enum": [
            "in",
            "out",
            "in-out",
            "symmetric",
            "unknown"
          ],
          "title": "Direction",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        }
      },
      "required": [
        "ref",
        "role"
      ],
      "title": "Participant",
      "type": "object"
    },
    "PurposeCriterion": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "family": {
          "const": "function-purpose-reference-criterion",
          "default": "function-purpose-reference-criterion",
          "title": "Family",
          "type": "string"
        },
        "role": {
          "enum": [
            "function",
            "purpose",
            "goal",
            "reference",
            "criterion",
            "constraint",
            "inquiry-objective"
          ],
          "title": "Role",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ref"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attributed_basis": {
          "default": "unknown",
          "enum": [
            "stated",
            "inferred",
            "assumed",
            "unknown"
          ],
          "title": "Attributed Basis",
          "type": "string"
        },
        "definition": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Definition",
          "type": "object"
        },
        "horizon": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Horizon",
          "type": "object"
        },
        "conflicts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "feasibility": {
          "default": "unknown",
          "title": "Feasibility",
          "type": "string"
        },
        "normative_scope": {
          "default": "unknown",
          "title": "Normative Scope",
          "type": "string"
        }
      },
      "required": [
        "role"
      ],
      "title": "PurposeCriterion",
      "type": "object"
    },
    "Put": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "operation": {
          "const": "put",
          "default": "put",
          "title": "Operation",
          "type": "string"
        },
        "representation": {
          "$ref": "#/$defs/Representation"
        },
        "expected_version": {
          "minimum": 0,
          "title": "Expected Version",
          "type": "integer"
        },
        "admission": {
          "anyOf": [
            {
              "$ref": "#/$defs/Admission"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "representation",
        "expected_version"
      ],
      "title": "Put",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "Exact numeric strings are retained; conversion is an explicit later derivation.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "known",
            "unknown",
            "missing",
            "not-applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "scale": {
          "default": "unknown",
          "enum": [
            "cardinal",
            "ordinal",
            "categorical",
            "unknown"
          ],
          "title": "Scale",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "unknown_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Reason"
        },
        "context": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Context",
          "type": "object"
        }
      },
      "required": [
        "status"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "Ref": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "record_id"
      ],
      "title": "Ref",
      "type": "object"
    },
    "Representation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "scope_id": {
          "default": "world",
          "maxLength": 256,
          "minLength": 1,
          "title": "Scope Id",
          "type": "string"
        },
        "structure": {
          "discriminator": {
            "mapping": {
              "constituent": "#/$defs/Constituent",
              "feedback-path": "#/$defs/FeedbackPath",
              "flow-process": "#/$defs/FlowProcess",
              "function-purpose-reference-criterion": "#/$defs/PurposeCriterion",
              "history-conditional-trajectory": "#/$defs/HistoryTrajectory",
              "information-influence-link": "#/$defs/InformationLink",
              "response-relationship": "#/$defs/ResponseRelationship",
              "stock": "#/$defs/Stock",
              "system-view": "#/$defs/SystemView"
            },
            "propertyName": "family"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/SystemView"
            },
            {
              "$ref": "#/$defs/Constituent"
            },
            {
              "$ref": "#/$defs/Stock"
            },
            {
              "$ref": "#/$defs/FlowProcess"
            },
            {
              "$ref": "#/$defs/InformationLink"
            },
            {
              "$ref": "#/$defs/ResponseRelationship"
            },
            {
              "$ref": "#/$defs/PurposeCriterion"
            },
            {
              "$ref": "#/$defs/FeedbackPath"
            },
            {
              "$ref": "#/$defs/HistoryTrajectory"
            }
          ],
          "title": "Structure"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "dependencies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "alternatives": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Alternatives",
          "type": "array"
        },
        "alternative_group": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alternative Group"
        },
        "basis": {
          "default": "unknown",
          "enum": [
            "source-report",
            "derivation",
            "assumption",
            "hypothesis",
            "imported",
            "unknown"
          ],
          "title": "Basis",
          "type": "string"
        },
        "support": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Support",
          "type": "array"
        },
        "counterevidence": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Counterevidence",
          "type": "array"
        },
        "assumptions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "uncertainty": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Uncertainty",
          "type": "object"
        },
        "validity": {
          "$ref": "#/$defs/Validity"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Properties"
        },
        "method_lineage": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Method Lineage",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "structure"
      ],
      "title": "Representation",
      "type": "object"
    },
    "ResponseRelationship": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
