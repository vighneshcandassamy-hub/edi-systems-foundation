    },
    "model_revision": {
      "minimum": 1,
      "title": "Model Revision",
      "type": "integer"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "clock_mapping_assumption": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Clock Mapping Assumption",
      "type": "string"
    },
    "data": {
      "default": [],
