      "title": "Data",
      "type": "array"
    },
    "owned_goals": {
      "default": [],
      "items": {
        "maxLength": 8192,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Owned Goals",
      "type": "array"
    },
    "frames_and_memory": {
      "default": [],
      "items": {
        "maxLength": 8192,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "Frames And Memory",
      "type": "array"
    },
    "attributed_policy": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Attributed Policy",
      "type": "string"
    },
    "attribution": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Attribution",
      "type": "string"
    }
  },
  "required": [
    "workspace_id",
    "request_id",
    "view_id",
    "actor",
    "model_revision",
    "as_of",
    "clock_mapping_assumption",
    "attributed_policy",
    "attribution"
