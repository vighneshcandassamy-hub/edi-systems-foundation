{
  "$defs": {
    "AssessmentNote": {
      "additionalProperties": false,
      "description": "C0 imports an attributed C6 record; C4 does not manufacture C6's verdict.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "assessment_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "source_revision": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source Revision",
          "type": "string"
        },
        "summary": {
          "maxLength": 8192,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "status": {
          "const": "imported-unverified",
          "default": "imported-unverified",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "assessment_id",
        "source_revision",
        "summary"
      ],
      "title": "AssessmentNote",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "rounds": {
          "default": 2,
          "maximum": 4,
          "minimum": 1,
          "title": "Rounds",
          "type": "integer"
        },
        "rivals_per_round": {
          "default": 3,
          "maximum": 3,
          "minimum": 1,
          "title": "Rivals Per Round",
          "type": "integer"
        },
        "jobs": {
          "default": 4,
          "maximum": 6,
          "minimum": 1,
          "title": "Jobs",
          "type": "integer"
        },
        "reserved_tokens": {
          "default": 32768,
          "maximum": 131072,
          "minimum": 1,
          "title": "Reserved Tokens",
          "type": "integer"
        },
        "input_token_cap": {
          "default": 4096,
          "maximum": 16384,
          "minimum": 1,
          "title": "Input Token Cap",
          "type": "integer"
        },
        "output_token_cap": {
          "default": 4096,
          "maximum": 16384,
          "minimum": 1,
          "title": "Output Token Cap",
          "type": "integer"
        }
      },
      "title": "Budget",
      "type": "object"
    },
    "ControllerAccess": {
      "additionalProperties": false,
      "description": "C0 description from a hash-adopted mission, never an execution grant.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "const": "edi-controller-access/1.0",
          "default": "edi-controller-access/1.0",
          "title": "Version",
          "type": "string"
        },
        "grant_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Grant Id",
          "type": "string"
        },
        "mission_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Mission Sha256",
          "type": "string"
        },
        "not_before": {
          "format": "date-time",
          "title": "Not Before",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "operations": {
          "additionalProperties": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "maxProperties": 16,
          "title": "Operations",
          "type": "object"
        }
      },
      "required": [
        "grant_id",
        "mission_sha256",
        "not_before",
        "expires_at",
        "operations"
      ],
      "title": "ControllerAccess",
      "type": "object"
    },
    "ControllerProgress": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "turn": {
          "minimum": 0,
          "title": "Turn",
          "type": "integer"
        },
        "remaining_turns": {
          "minimum": 0,
          "title": "Remaining Turns",
          "type": "integer"
        },
        "remaining_policy_units": {
          "minimum": 0,
          "title": "Remaining Policy Units",
          "type": "integer"
        },
        "teacher_available": {
          "title": "Teacher Available",
          "type": "boolean"
        },
        "public_outcomes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PublicOutcome"
          },
          "maxItems": 16,
          "title": "Public Outcomes",
          "type": "array"
        }
      },
      "required": [
        "turn",
        "remaining_turns",
        "remaining_policy_units",
        "teacher_available"
      ],
      "title": "ControllerProgress",
      "type": "object"
    },
    "EvidenceSelection": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "offset": {
          "default": 0,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "length": {
          "default": 4096,
          "maximum": 65536,
          "minimum": 0,
          "title": "Length",
          "type": "integer"
        }
      },
      "required": [
        "record_id"
      ],
      "title": "EvidenceSelection",
      "type": "object"
    },
    "JsonValue": {},
    "PublicOutcome": {
      "additionalProperties": false,
      "description": "C0 receipt metadata; not a model claim or complete access history.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "operation": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "request_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "http_status": {
          "maximum": 599,
          "minimum": 100,
          "title": "Http Status",
          "type": "integer"
        }
      },
      "required": [
        "operation",
        "request_id",
        "http_status"
      ],
      "title": "PublicOutcome",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "inquiry_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Inquiry Id",
      "type": "string"
    },
    "request_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "question": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "purpose": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Purpose",
      "type": "string"
    },
    "scope": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "horizon": {
      "maxLength": 8192,
      "minLength": 1,
      "title": "Horizon",
      "type": "string"
    },
    "response_mode": {
      "default": "proposal",
      "description": "A controller turn needs exactly one next-operation proposal or explicit yield; proposal mode permits reasoning-only output.",
      "enum": [
        "proposal",
        "controller-turn"
      ],
      "title": "Response Mode",
      "type": "string"
    },
    "controller_access": {
      "anyOf": [
        {
          "$ref": "#/$defs/ControllerAccess"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "controller_policy": {
      "default": "legacy",
      "enum": [
        "legacy",
        "information-seeking/1.0"
      ],
      "title": "Controller Policy",
      "type": "string"
    },
    "controller_progress": {
      "anyOf": [
        {
          "$ref": "#/$defs/ControllerProgress"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model_revision": {
      "minimum": 0,
      "title": "Model Revision",
      "type": "integer"
    },
    "world_ids": {
      "default": [],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "title": "World Ids",
      "type": "array"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceSelection"
      },
      "maxItems": 16,
      "title": "Evidence",
      "type": "array"
    },
    "axes": {
      "default": [
        "evidence",
        "boundary",
        "rivals",
        "learning"
      ],
      "items": {
        "enum": [
          "evidence",
          "boundary",
          "organization",
          "accumulation",
          "feedback-delay",
          "nonlinearity",
          "agency",
          "resilience-evolution",
          "rivals",
          "intervention",
          "learning"
        ],
        "type": "string"
      },
      "maxItems": 11,
      "minItems": 1,
      "title": "Axes",
      "type": "array"
    },
    "omitted_frontier": {
      "default": [],
      "items": {
        "maxLength": 8192,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Omitted Frontier",
      "type": "array"
    },
    "unknowns": {
      "default": [],
      "items": {
        "maxLength": 8192,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Unknowns",
      "type": "array"
    },
    "assessments": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AssessmentNote"
      },
      "maxItems": 8,
      "title": "Assessments",
      "type": "array"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    }
  },
  "required": [
    "workspace_id",
    "inquiry_id",
    "request_id",
    "question",
    "purpose",
    "scope",
    "horizon",
    "model_revision"
  ],
  "title": "InquiryRequest",
  "type": "object"
}
