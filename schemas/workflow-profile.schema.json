{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "profile_id": {
      "default": "local-workflow-v1",
      "maxLength": 256,
      "minLength": 1,
      "title": "Profile Id",
      "type": "string"
    },
    "workspace_id": {
      "default": "default",
      "maxLength": 256,
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    },
    "database": {
      "format": "path",
      "title": "Database",
      "type": "string"
    },
    "trusted_operator_steps": {
      "default": false,
      "title": "Trusted Operator Steps",
      "type": "boolean"
    },
    "operator_ids": {
      "default": [
        "local-operator"
      ],
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Operator Ids",
      "type": "array"
    },
    "max_plan_bytes": {
      "default": 524288,
      "minimum": 1024,
      "title": "Max Plan Bytes",
      "type": "integer"
    },
    "max_input_bytes": {
      "default": 262144,
      "minimum": 1024,
      "title": "Max Input Bytes",
      "type": "integer"
    },
    "max_step_bytes": {
      "default": 4194304,
      "minimum": 65536,
      "title": "Max Step Bytes",
      "type": "integer"
    },
    "max_stored_bytes": {
      "default": 268435456,
      "minimum": 65536,
      "title": "Max Stored Bytes",
      "type": "integer"
    },
    "max_records": {
      "default": 10000,
      "minimum": 4,
      "title": "Max Records",
      "type": "integer"
    },
    "max_resume_seconds": {
      "default": 30.0,
      "exclusiveMinimum": 0,
      "maximum": 300,
      "title": "Max Resume Seconds",
      "type": "number"
    },
    "writer_timeout_seconds": {
      "default": 5.0,
      "exclusiveMinimum": 0,
      "maximum": 60,
      "title": "Writer Timeout Seconds",
      "type": "number"
    },
    "min_free_disk_bytes": {
      "default": 268435456,
      "minimum": 0,
      "title": "Min Free Disk Bytes",
      "type": "integer"
